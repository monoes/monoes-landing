{
  "name": "monoes-landing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "find . -name '._*' -not -path './.git/*' -not -path './node_modules/*' -not -path './.next/*' -not -path './.monomind/*' -delete 2>/dev/null || true",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply monoes-community --local",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "test": "node --experimental-strip-types --test 'src/**/*.test.ts'",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "better-auth": "^1.6.0",
    "drizzle-orm": "^0.45.0",
    "framer-motion": "^12.38.0",
    "gsap": "^3.15.0",
    "isomorphic-dompurify": "^3.22.0",
    "marked": "^18.0.10",
    "next": "^16.2.10",
    "node-html-markdown": "^2.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.19.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "playwright": "^1.62.1",
    "puppeteer": "^25.7.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
