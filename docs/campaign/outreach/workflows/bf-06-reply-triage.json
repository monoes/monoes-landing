      "position": {
        "x": 3540,
        "y": 320
      },
      "config": {
        "to": "{{ $json.handle }}",
        "subject": "Re: Monoes",
        "body": "{{ $json.draft }}",
        "body_type": "text"
      },
      "disabled": true
    }
  ],
